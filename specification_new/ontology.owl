        </rdfs:subClassOf>
        <rdfs:comment>The genre of a movie, i.e. adventure, or rom-com. A movie can have multiple genres.</rdfs:comment>
    </owl:Class>
    


    <!-- https://github.com/addonico/RatO/ontology/language -->


    <owl:Class rdf:about="https://github.com/addonico/RatO/ontology/language">
