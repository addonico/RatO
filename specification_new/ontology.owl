<?xml version="1.0"?>
<rdf:RDF xmlns="https://github.com/addonico/RatO/ontology/"
     xml:base="https://github.com/addonico/RatO/ontology/"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:ns="http://www.w3.org/2003/06/sw-vocab-status/ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:wot="http://xmlns.com/wot/0.1/"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrla="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:ontology="https://github.com/addonico/RatO/ontology/">
    <owl:Ontology rdf:about="https://github.com/addonico/RatO/ontology/">
        <owl:versionIRI rdf:resource="https://github.com/addonico/RatO/ontology/1.0"/>
        <owl:imports rdf:resource="http://xmlns.com/foaf/0.1/"/>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled -->


    <owl:AnnotationProperty rdf:about="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2002/07/owl#differentFrom -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/2002/07/owl#differentFrom"/>
    


    <!-- https://github.com/addonico/RatO/ontology/actedIn -->


    <owl:ObjectProperty rdf:about="https://github.com/addonico/RatO/ontology/actedIn">
        <rdfs:subPropertyOf rdf:resource="https://github.com/addonico/RatO/ontology/workedOn"/>
        <owl:inverseOf rdf:resource="https://github.com/addonico/RatO/ontology/features"/>
        <rdfs:domain rdf:resource="https://github.com/addonico/RatO/ontology/actor"/>
        <rdfs:range rdf:resource="https://github.com/addonico/RatO/ontology/movie"/>
        <rdfs:comment>An actor/actress that acted in a movie. Inverse of the property &quot;featured&quot;.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://github.com/addonico/RatO/ontology/consistsOf -->


    <owl:ObjectProperty rdf:about="https://github.com/addonico/RatO/ontology/consistsOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://github.com/addonico/RatO/ontology/ratingGiver"/>
        <rdfs:range rdf:resource="https://github.com/addonico/RatO/ontology/voters"/>
        <rdfs:comment>The property relates the rating body with the people constituting it.</rdfs:comment>
        <rdfs:label>consists of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/addonico/RatO/ontology/directedBy -->


    <owl:ObjectProperty rdf:about="https://github.com/addonico/RatO/ontology/directedBy">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="https://github.com/addonico/RatO/ontology/directs"/>
        <rdfs:domain rdf:resource="https://github.com/addonico/RatO/ontology/movie"/>
        <rdfs:range rdf:resource="https://github.com/addonico/RatO/ontology/director"/>
        <rdfs:comment>Property relating the movie with its director(s). Inverse of &quot;directed&quot;.</rdfs:comment>
        <rdfs:label>directed by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/addonico/RatO/ontology/directs -->


    <owl:ObjectProperty rdf:about="https://github.com/addonico/RatO/ontology/directs">
        <rdfs:subPropertyOf rdf:resource="https://github.com/addonico/RatO/ontology/workedOn"/>
        <rdfs:comment>The director who directed the movie. Inverse of &quot;directedBy&quot;.</rdfs:comment>
        <rdfs:label>directed</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/addonico/RatO/ontology/expressedBy -->


    <owl:ObjectProperty rdf:about="https://github.com/addonico/RatO/ontology/expressedBy">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="https://github.com/addonico/RatO/ontology/expresses"/>
        <rdfs:domain rdf:resource="https://github.com/addonico/RatO/ontology/rating"/>
        <rdfs:range rdf:resource="https://github.com/addonico/RatO/ontology/ratingGiver"/>
        <rdfs:comment>The property connects the rating with its source, e.g, &quot;IMDb&quot;.</rdfs:comment>
        <rdfs:label>Expressed by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/addonico/RatO/ontology/expressedOn -->


    <owl:ObjectProperty rdf:about="https://github.com/addonico/RatO/ontology/expressedOn">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="https://github.com/addonico/RatO/ontology/hasRating"/>
        <rdfs:domain rdf:resource="https://github.com/addonico/RatO/ontology/rating"/>
        <rdfs:range rdf:resource="https://github.com/addonico/RatO/ontology/movie"/>
        <rdfs:comment>The property connects a rating with the movie it describes. Inverse of &quot;hasRating&quot;.</rdfs:comment>
        <rdfs:label>expressed on</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/addonico/RatO/ontology/expressedWith -->


    <owl:ObjectProperty rdf:about="https://github.com/addonico/RatO/ontology/expressedWith">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://github.com/addonico/RatO/ontology/rating"/>
        <rdfs:range rdf:resource="https://github.com/addonico/RatO/ontology/scale"/>
        <rdfs:comment>The property connecting a score to the scale used to express it.</rdfs:comment>
        <rdfs:label>expressed with</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/addonico/RatO/ontology/expresses -->


    <owl:ObjectProperty rdf:about="https://github.com/addonico/RatO/ontology/expresses">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://github.com/addonico/RatO/ontology/ratingGiver"/>
        <rdfs:range rdf:resource="https://github.com/addonico/RatO/ontology/rating"/>
        <rdfs:comment>Property relating the rating authority to the rating it expressed. Inverse of &quot;expressedBy&quot;.</rdfs:comment>
        <rdfs:label>expresses</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/addonico/RatO/ontology/features -->


    <owl:ObjectProperty rdf:about="https://github.com/addonico/RatO/ontology/features">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:comment>The property connects the movie with the actor/actress who acted in it. Inverse of &quot;actedIn&quot;.</rdfs:comment>
        <rdfs:label>featured</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/addonico/RatO/ontology/givenBy -->


    <owl:ObjectProperty rdf:about="https://github.com/addonico/RatO/ontology/givenBy">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="https://github.com/addonico/RatO/ontology/gives"/>
        <rdfs:domain rdf:resource="https://github.com/addonico/RatO/ontology/award"/>
        <rdfs:range rdf:resource="https://github.com/addonico/RatO/ontology/awardingBody"/>
        <rdfs:comment>Property connecting the award to the awarding body or event that assigns it. Inverse of &quot;gives&quot;.</rdfs:comment>
        <rdfs:label>given by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/addonico/RatO/ontology/gives -->


    <owl:ObjectProperty rdf:about="https://github.com/addonico/RatO/ontology/gives">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:comment>The property specifies the award that a body, event or institution assigns to a movie. Inverse of &quot;givenBy&quot;.</rdfs:comment>
        <rdfs:label>gives</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/addonico/RatO/ontology/hasCategory -->


    <owl:ObjectProperty rdf:about="https://github.com/addonico/RatO/ontology/hasCategory">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://github.com/addonico/RatO/ontology/award"/>
        <rdfs:range rdf:resource="https://github.com/addonico/RatO/ontology/category"/>
        <rdfs:comment>Property specifying the category of the award related to a movie, e.g. &quot;Top Box Office Movie&quot;.</rdfs:comment>
        <rdfs:label>has category</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/addonico/RatO/ontology/hasGenre -->


    <owl:ObjectProperty rdf:about="https://github.com/addonico/RatO/ontology/hasGenre">
        <rdfs:domain rdf:resource="https://github.com/addonico/RatO/ontology/movie"/>
        <rdfs:range rdf:resource="https://github.com/addonico/RatO/ontology/genre"/>
        <rdfs:comment>Property relating the movie to its genres.</rdfs:comment>
        <rdfs:label>has genre</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/addonico/RatO/ontology/hasRating -->


    <owl:ObjectProperty rdf:about="https://github.com/addonico/RatO/ontology/hasRating">
        <rdfs:domain rdf:resource="https://github.com/addonico/RatO/ontology/movie"/>
        <rdfs:range rdf:resource="https://github.com/addonico/RatO/ontology/rating"/>
        <rdfs:comment>The property refers the movie to its ratings. Inverse of &quot;expressedOn&quot;.</rdfs:comment>
        <rdfs:label>has rating</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/addonico/RatO/ontology/produced -->


    <owl:ObjectProperty rdf:about="https://github.com/addonico/RatO/ontology/produced">
        <rdfs:subPropertyOf rdf:resource="https://github.com/addonico/RatO/ontology/workedOn"/>
        <owl:inverseOf rdf:resource="https://github.com/addonico/RatO/ontology/producedBy"/>
        <rdfs:comment>The person producing a movie. Inverse of &quot;producedBy&quot;.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://github.com/addonico/RatO/ontology/producedBy -->


    <owl:ObjectProperty rdf:about="https://github.com/addonico/RatO/ontology/producedBy">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://github.com/addonico/RatO/ontology/movie"/>
        <rdfs:range rdf:resource="https://github.com/addonico/RatO/ontology/producer"/>
        <rdfs:comment>Property connecting the movie with its producer. Inverse of &quot;produced&quot;.</rdfs:comment>
        <rdfs:label>produced by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/addonico/RatO/ontology/wonAward -->


    <owl:ObjectProperty rdf:about="https://github.com/addonico/RatO/ontology/wonAward">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://github.com/addonico/RatO/ontology/movie"/>
        <rdfs:range rdf:resource="https://github.com/addonico/RatO/ontology/award"/>
        <rdfs:comment>Property relating the movie with the awards.</rdfs:comment>
        <rdfs:label>won award</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/addonico/RatO/ontology/workedOn -->


    <owl:ObjectProperty rdf:about="https://github.com/addonico/RatO/ontology/workedOn">
        <rdfs:domain rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
        <rdfs:range rdf:resource="https://github.com/addonico/RatO/ontology/movie"/>
        <rdfs:comment>Any activity perfomed by a person while working on a movie, i.e., producing, writing, taking care of photography or costumes.</rdfs:comment>
        <rdfs:label>worked on</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/addonico/RatO/ontology/workedWith -->


    <owl:ObjectProperty rdf:about="https://github.com/addonico/RatO/ontology/workedWith">
        <rdfs:subPropertyOf rdf:resource="http://xmlns.com/foaf/0.1/knows"/>
        <rdfs:domain rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
        <rdfs:range rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="https://github.com/addonico/RatO/ontology/workedOn"/>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://github.com/addonico/RatO/ontology/workedOn"/>
            </rdf:Description>
        </owl:propertyChainAxiom>
        <rdfs:comment>Property connecting two people who have worked on the same movie, regardless of their specific job.</rdfs:comment>
        <rdfs:label>worked with</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/addonico/RatO/ontology/writes -->


    <owl:ObjectProperty rdf:about="https://github.com/addonico/RatO/ontology/writes">
        <rdfs:subPropertyOf rdf:resource="https://github.com/addonico/RatO/ontology/workedOn"/>
        <owl:inverseOf rdf:resource="https://github.com/addonico/RatO/ontology/writtenBy"/>
        <rdfs:domain rdf:resource="https://github.com/addonico/RatO/ontology/screenwriter"/>
        <rdfs:range rdf:resource="https://github.com/addonico/RatO/ontology/movie"/>
        <rdfs:comment>The screenwriter writing a movie. Inverse of &quot;writtenBy&quot;.</rdfs:comment>
        <rdfs:label>wrote</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/addonico/RatO/ontology/writtenBy -->


    <owl:ObjectProperty rdf:about="https://github.com/addonico/RatO/ontology/writtenBy">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:comment>Property connecting a movie to its screenwriter. Inverse of &quot;wrote&quot;.</rdfs:comment>
        <rdfs:label>written by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://xmlns.com/foaf/0.1/givenName -->


    <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/givenName">
        <rdfs:domain rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </rdf:Description>
    


    <!-- https://github.com/addonico/RatO/ontology/basedOn -->


    <owl:DatatypeProperty rdf:about="https://github.com/addonico/RatO/ontology/basedOn">
        <rdfs:domain rdf:resource="https://github.com/addonico/RatO/ontology/rating"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>The number of votes that determine the score, i.e., a five-star score based on twenty votes.</rdfs:comment>
        <rdfs:label>based on</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://github.com/addonico/RatO/ontology/hasCategoryName -->


    <owl:DatatypeProperty rdf:about="https://github.com/addonico/RatO/ontology/hasCategoryName">
        <rdfs:domain rdf:resource="https://github.com/addonico/RatO/ontology/category"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <owl:propertyDisjointWith rdf:resource="https://github.com/addonico/RatO/ontology/#hasName"/>
        <rdfs:comment>The name of an award&apos;s category, e.g. &quot;Top Box Office Movie&quot;.</rdfs:comment>
        <rdfs:label>has category name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://github.com/addonico/RatO/ontology/hasLanguage -->


    <owl:DatatypeProperty rdf:about="https://github.com/addonico/RatO/ontology/hasLanguage">
        <rdfs:domain rdf:resource="https://github.com/addonico/RatO/ontology/movie"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Property specifying the main language spoken in a movie.</rdfs:comment>
        <rdfs:label>has language</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://github.com/addonico/RatO/ontology/hasOriginalTitle -->


    <owl:DatatypeProperty rdf:about="https://github.com/addonico/RatO/ontology/hasOriginalTitle">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://github.com/addonico/RatO/ontology/movie"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <owl:propertyDisjointWith rdf:resource="https://github.com/addonico/RatO/ontology/hasTitle"/>
        <rdfs:comment>The original title of a movie.</rdfs:comment>
        <rdfs:label>has original title</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://github.com/addonico/RatO/ontology/hasReleaseDate -->


    <owl:DatatypeProperty rdf:about="https://github.com/addonico/RatO/ontology/hasReleaseDate">
        <rdfs:domain rdf:resource="https://github.com/addonico/RatO/ontology/movie"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment>Property specifying the date of release of a movie, expressed only by its year, e.g. &quot;2015&quot;.</rdfs:comment>
        <rdfs:label>has release date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://github.com/addonico/RatO/ontology/hasScore -->


    <owl:DatatypeProperty rdf:about="https://github.com/addonico/RatO/ontology/hasScore">
        <rdfs:domain rdf:resource="https://github.com/addonico/RatO/ontology/rating"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Property expressing the value, numerical or literal, of a rating.</rdfs:comment>
        <rdfs:label>has score</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://github.com/addonico/RatO/ontology/hasTitle -->


    <owl:DatatypeProperty rdf:about="https://github.com/addonico/RatO/ontology/hasTitle">
        <rdfs:domain rdf:resource="https://github.com/addonico/RatO/ontology/movie"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Property declaring the main title a movie is known with.</rdfs:comment>
        <rdfs:label>has title</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://github.com/addonico/RatO/ontology/hasType -->


    <owl:DatatypeProperty rdf:about="https://github.com/addonico/RatO/ontology/hasType">
        <rdfs:domain rdf:resource="https://github.com/addonico/RatO/ontology/category"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <owl:propertyDisjointWith rdf:resource="https://github.com/addonico/RatO/ontology/#hasName"/>
        <rdfs:comment>The property specifying whether a movie was only nominated or also won an award.</rdfs:comment>
        <rdfs:label>has type</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://github.com/addonico/RatO/ontology/hasValue -->


    <owl:DatatypeProperty rdf:about="https://github.com/addonico/RatO/ontology/hasValue">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The property specifies the type of genre of a movie.</rdfs:comment>
        <rdfs:label>has value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://github.com/addonico/RatO/ontology/#hasName -->


    <owl:DatatypeProperty rdf:about="https://github.com/addonico/RatO/ontology/#hasName">
        <rdfs:domain rdf:resource="https://github.com/addonico/RatO/ontology/awardingBody"/>
        <rdfs:domain rdf:resource="https://github.com/addonico/RatO/ontology/ratingGiver"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Property specifying the name of a deciding body (assigning an award or a rating).</rdfs:comment>
        <rdfs:label>has name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://xmlns.com/foaf/0.1/Person -->


    <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Person">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://xmlns.com/foaf/0.1/givenName"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </rdf:Description>
    


    <!-- https://github.com/addonico/RatO/ontology/actor -->


    <owl:Class rdf:about="https://github.com/addonico/RatO/ontology/actor">
        <rdfs:subClassOf rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
        <rdfs:comment>An actor or actress who acted in the movie</rdfs:comment>
    </owl:Class>
    


    <!-- https://github.com/addonico/RatO/ontology/award -->


    <owl:Class rdf:about="https://github.com/addonico/RatO/ontology/award">
        <rdfs:comment>An award given by an awarding body to a movie or a person involved in its production</rdfs:comment>
        <rdfs:label>Award</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/addonico/RatO/ontology/awardType -->


    <owl:Class rdf:about="https://github.com/addonico/RatO/ontology/awardType">
        <rdfs:comment>The status of the award: a movie can win a specific awards, or just be nominated for it</rdfs:comment>
    </owl:Class>
    


    <!-- https://github.com/addonico/RatO/ontology/awardingBody -->


    <owl:Class rdf:about="https://github.com/addonico/RatO/ontology/awardingBody">
        <rdfs:comment>An organization or event assigning awards to movies and people involved in their productions</rdfs:comment>
    </owl:Class>
    


    <!-- https://github.com/addonico/RatO/ontology/category -->


    <owl:Class rdf:about="https://github.com/addonico/RatO/ontology/category">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://github.com/addonico/RatO/ontology/hasCategoryName"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>The category of the award, i.e. &quot;Best Cinematography&quot; of the BSFC Award.</rdfs:comment>
    </owl:Class>
    


    <!-- https://github.com/addonico/RatO/ontology/decimalScale -->


    <owl:Class rdf:about="https://github.com/addonico/RatO/ontology/decimalScale">
        <rdfs:subClassOf rdf:resource="https://github.com/addonico/RatO/ontology/scale"/>
        <rdfs:comment>A ten-based scale, with 1 being the lowest score and 10 the highest.</rdfs:comment>
    </owl:Class>
    


    <!-- https://github.com/addonico/RatO/ontology/director -->


    <owl:Class rdf:about="https://github.com/addonico/RatO/ontology/director">
        <rdfs:subClassOf rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
        <rdfs:comment>The director of a movie. A movie can have one or more directors.</rdfs:comment>
    </owl:Class>
    


    <!-- https://github.com/addonico/RatO/ontology/fiveStars -->


    <owl:Class rdf:about="https://github.com/addonico/RatO/ontology/fiveStars">
        <rdfs:subClassOf rdf:resource="https://github.com/addonico/RatO/ontology/scale"/>
        <rdfs:comment>A scale based on five starts, with one star being a low rating and five being the highest.</rdfs:comment>
    </owl:Class>
    


    <!-- https://github.com/addonico/RatO/ontology/genre -->


    <owl:Class rdf:about="https://github.com/addonico/RatO/ontology/genre">
